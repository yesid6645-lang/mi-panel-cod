# Token de Dropi → Mis integraciones (no lo subas a git)
DROPI_TOKEN=
# URL base de la API de Dropi para Ecuador (por confirmar)
DROPI_API_URL=https://api.dropi.ec
# Meta Ads: token de acceso y cuenta publicitaria (act_XXXX)
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
# Tasa para convertir pauta en COP a USD (COP por 1 USD)
COP_PER_USD=4000
# Inicio de sesión con Facebook (app de developers.facebook.com → Configuración → Básica)
META_APP_ID=
META_APP_SECRET=
# Id de la configuración de "Inicio de sesión con Facebook para empresas"
META_LOGIN_CONFIG_ID=
# Dirección donde abres el panel (para la vuelta del login de Facebook)
APP_URL=http://localhost:3000
