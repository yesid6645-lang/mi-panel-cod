# Los tokens de Dropi de cada tienda se ponen en el panel (Tiendas y conexiones).
# Tasa por defecto para convertir pauta en COP a una tienda en USD (COP por 1 USD)
COP_PER_USD=3900
# Inicio de sesión con Facebook (app de developers.facebook.com → Configuración → Básica)
META_APP_ID=
META_APP_SECRET=
# Id de la configuración de "Inicio de sesión con Facebook para empresas"
META_LOGIN_CONFIG_ID=
# Dirección donde abres el panel (para la vuelta del login de Facebook)
APP_URL=http://localhost:3000

# ---- Publicado (Netlify + Supabase) ----
# Supabase → Project Settings → API. La service_role es secreta: solo en Netlify, nunca en el navegador.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Correos que pueden entrar al panel, separados por coma
CORREOS_PERMITIDOS=
